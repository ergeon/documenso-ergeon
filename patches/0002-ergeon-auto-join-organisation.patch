diff --git a/packages/lib/server-only/organisation/auto-join-organisation.ts b/packages/lib/server-only/organisation/auto-join-organisation.ts
new file mode 100644
index 0000000..136eedc
--- /dev/null
+++ b/packages/lib/server-only/organisation/auto-join-organisation.ts
@@ -0,0 +1,85 @@
+import { prisma } from '@documenso/prisma';
+import { OrganisationMemberInviteStatus, OrganisationMemberRole } from '@prisma/client';
+
+import { env } from '../../utils/env';
+import { logger } from '../../utils/logger';
+import { addUserToOrganisation } from './accept-organisation-invitation';
+
+/**
+ * Stand-in for the enterprise-only organisation SSO portal: users whose email is on
+ * NEXT_PRIVATE_AUTO_JOIN_EMAIL_DOMAIN become members of NEXT_PRIVATE_AUTO_JOIN_ORGANISATION_ID
+ * without accepting an invite. Leaving either unset turns it off.
+ */
+const getAutoJoinSettings = () => {
+  const organisationId = env('NEXT_PRIVATE_AUTO_JOIN_ORGANISATION_ID')?.trim();
+  const emailDomain = env('NEXT_PRIVATE_AUTO_JOIN_EMAIL_DOMAIN')?.trim().toLowerCase();
+
+  if (!organisationId || !emailDomain) {
+    return null;
+  }
+
+  return { organisationId, emailDomain };
+};
+
+export const isAutoJoinEmail = (email: string) => {
+  const settings = getAutoJoinSettings();
+
+  return settings !== null && email.toLowerCase().endsWith(`@${settings.emailDomain}`);
+};
+
+export type AutoJoinOrganisationOptions = {
+  userId: number;
+  email: string;
+};
+
+/**
+ * Runs on every page load, so the common case is one lookup on the member's unique index.
+ * Never throws: a failure here must not stop the user from using the app.
+ */
+export const autoJoinOrganisation = async ({ userId, email }: AutoJoinOrganisationOptions) => {
+  const settings = getAutoJoinSettings();
+
+  if (!settings || !isAutoJoinEmail(email)) {
+    return;
+  }
+
+  const { organisationId } = settings;
+
+  try {
+    const existingMember = await prisma.organisationMember.findUnique({
+      where: { userId_organisationId: { userId, organisationId } },
+      select: { id: true },
+    });
+
+    if (existingMember) {
+      return;
+    }
+
+    const organisation = await prisma.organisation.findUniqueOrThrow({
+      where: { id: organisationId },
+      include: { groups: true },
+    });
+
+    // No "member joined" email: admins would get one for every colleague's first visit.
+    await addUserToOrganisation({
+      userId,
+      organisationId,
+      organisationGroups: organisation.groups,
+      organisationMemberRole: OrganisationMemberRole.MEMBER,
+      bypassEmail: true,
+    });
+
+    await prisma.organisationMemberInvite.updateMany({
+      where: {
+        organisationId,
+        email: { equals: email, mode: 'insensitive' },
+        status: OrganisationMemberInviteStatus.PENDING,
+      },
+      data: { status: OrganisationMemberInviteStatus.ACCEPTED },
+    });
+
+    logger.info({ msg: 'Auto-joined user to organisation', userId, organisationId });
+  } catch (err) {
+    logger.error({ msg: 'Failed to auto-join user to organisation', err, userId, organisationId });
+  }
+};
